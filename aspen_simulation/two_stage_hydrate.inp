TITLE 'TWO-STAGE HYDRATE CO2 CAPTURE WITH RECYCLE'
IN-UNITS MET VOLUME-FLOW='cum/hr' ENTHALPY-FLO='Gcal/hr' HEAT-TRANS-C='kcal/hr-sqm-C' PRESSURE=bar TEMPERATURE=C
DEF-STREAMS CONVEN ALL
DATABANKS 'APV140 PURE40' / 'APV140 AQUEOUS' / 'APV140 SOLIDS' / 'APV140 INORGANIC' / 'NOASPENPCD'
PROP-SOURCES 'APV140 PURE40' / 'APV140 AQUEOUS' / 'APV140 SOLIDS' / 'APV140 INORGANIC'
COMPONENTS
    CO2 CO2 /
    H2 H2 /
    H2O H2O /
    DIOX C4H8O2-1
FLOWSHEET
    BLOCK COMP-1 IN=S1 OUT=S2
    BLOCK CHILL-1 IN=S2 OUT=S3
    BLOCK MIX-1 IN=S3 S11 OUT=S4
    BLOCK FORM-1 IN=S4 OUT=S5 S6
    BLOCK VALV-1 IN=S6 OUT=S7
    BLOCK DISS-1 IN=S7 OUT=S8 S9
    BLOCK PUMP-1 IN=S9 OUT=S10
    BLOCK CHILL-2 IN=S10 OUT=S11
    BLOCK COMP-2 IN=S8 OUT=S12
    BLOCK CHILL-3 IN=S12 OUT=S13
    BLOCK MIX-2 IN=S13 S21 OUT=S14
    BLOCK FORM-2 IN=S14 OUT=S15 S16
    BLOCK VALV-2 IN=S16 OUT=S17
    BLOCK DISS-2 IN=S17 OUT=S18 S19
    BLOCK PUMP-2 IN=S19 OUT=S20
    BLOCK CHILL-4 IN=S20 OUT=S21
PROPERTIES RK-SOAVE
STREAM S1
    SUBSTREAM MIXED TEMP=30. PRES=25. MOLE-FLOW=100.
    MOLE-FRAC CO2 0.40 / H2 0.60 / H2O 0.0 / DIOX 0.0
STREAM S11
    SUBSTREAM MIXED TEMP=1. PRES=24.8 MOLE-FLOW=1200.
    MOLE-FRAC CO2 0.0 / H2 0.0 / H2O 0.9444 / DIOX 0.0556
STREAM S21
    SUBSTREAM MIXED TEMP=1. PRES=24.8 MOLE-FLOW=400.
    MOLE-FRAC CO2 0.0 / H2 0.0 / H2O 0.9444 / DIOX 0.0556
BLOCK COMP-1 COMPR
    PARAM TYPE=ASME-ISEN PRES=25. EFF=0.75
BLOCK CHILL-1 HEATER
    PARAM TEMP=1. PRES=24.8
BLOCK MIX-1 MIXER
BLOCK FORM-1 SEP
    PARAM
    FRAC STREAM=S5 COMPS=H2 CO2 H2O DIOX FRACS=0.9927 0.28 0.0001 0.0001
BLOCK VALV-1 VALVE
    PARAM PRES=4.0
BLOCK DISS-1 FLASH2
    PARAM TEMP=12. PRES=4.0
BLOCK PUMP-1 PUMP
    PARAM PRES=25. EFF=0.70
BLOCK CHILL-2 HEATER
    PARAM TEMP=1. PRES=24.8
BLOCK COMP-2 COMPR
    PARAM TYPE=ASME-ISEN PRES=25. EFF=0.75
BLOCK CHILL-3 HEATER
    PARAM TEMP=1. PRES=24.8
BLOCK MIX-2 MIXER
BLOCK FORM-2 SEP
    PARAM
    FRAC STREAM=S15 COMPS=H2 CO2 H2O DIOX FRACS=0.90 0.12 0.0001 0.0001
BLOCK VALV-2 VALVE
    PARAM PRES=4.0
BLOCK DISS-2 FLASH2
    PARAM TEMP=12. PRES=4.0
BLOCK PUMP-2 PUMP
    PARAM PRES=25. EFF=0.70
BLOCK CHILL-4 HEATER
    PARAM TEMP=1. PRES=24.8
CONVERGENCE
    TEAR S11 S21
